<?php
include 'config.php';

if (isset($_GET['id'])) {
    $id = mysqli_real_escape_string($conexion, $_GET['id']);

    $check = $conexion->query("SELECT id_socio FROM socios WHERE id_membresia = $id LIMIT 1");
    
    if ($check->num_rows > 0) {
        // Si hay socios usandola, mejor no borrarla
        echo "<script>alert('No puedes eliminar esta membresía porque hay socios inscritos en ella. Primero cámbialos de plan.'); window.location='membresias.php';</script>";
    } else {
        // validacion de si ningun socio la tiene se puede eliminar
        $sql = "DELETE FROM membresias WHERE id_membresia = $id";
        if ($conexion->query($sql)) {
            header("Location: membresias.php?res=eliminado");
        } else {
            echo "Error al eliminar: " . $conexion->error;
        }
    }
} else {
    header("Location: membresias.php");
}
?>